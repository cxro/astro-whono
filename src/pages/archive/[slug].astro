---
import { render } from 'astro:content';
import { getEssaySlug, getVisibleEssayRouteEntries, type EssayEntry } from '../../lib/content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { createWithBase } from '../../utils/format';
import { getThemeSettings, getVisibleArticleMetaTags } from '../../lib/theme-settings';
import { getTagPath, normalizeTagLabel } from '../../lib/tags';

type ArticleNeighborLink = {
  href: string;
  title: string;
};

export const prerender = true;

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL ?? '/';
  const withBase = createWithBase(base);
  const routeEntries = await getVisibleEssayRouteEntries();
  return routeEntries.map(({ slug, entry, prev, next }) => {
    return {
      params: { slug },
      props: {
        entry,
        prev: prev
          ? { href: withBase(`/archive/${getEssaySlug(prev)}/`), title: prev.data.title }
          : null,
        next: next
          ? { href: withBase(`/archive/${getEssaySlug(next)}/`), title: next.data.title }
          : null
      }
    };
  });
}

const { entry, prev, next } = Astro.props as {
  entry: EssayEntry;
  prev: ArticleNeighborLink | null;
  next: ArticleNeighborLink | null;
};
const { Content, headings } = await render(entry);
const { settings } = getThemeSettings();
const { articleMeta: articleMetaSettings, articleToc, articleFooter } = settings.ui;
const visibleTags = getVisibleArticleMetaTags(entry.data.tags, 'detail');
const withBase = createWithBase(import.meta.env.BASE_URL ?? '/');
// 标签页只由归档文章生成，archive: false 的文章不保证标签有页面，显示纯文本。
const hasTagPages = entry.data.archive !== false;
const tags = entry.data.tags
  .map((tag) => normalizeTagLabel(tag))
  .filter(Boolean)
  .map((label) => ({ label, href: hasTagPages ? withBase(getTagPath('archive', label)) : null }));
const { name: authorName, avatar: authorAvatar } = settings.page.bits.defaultAuthor;
const poster = {
  siteName: settings.shell.brandTitle,
  authorName,
  authorAvatar: authorAvatar ? withBase(authorAvatar) : ''
};
---

<ArticleLayout
  entry={entry}
  prev={prev}
  next={next}
  articleMetaSettings={articleMetaSettings}
  articleFooterSettings={articleFooter}
  visibleTags={visibleTags}
  tags={tags}
  poster={poster}
  headings={headings}
  showToc={articleToc.showEntry}
>
  <Content />
</ArticleLayout>
