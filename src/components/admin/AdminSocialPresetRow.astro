---
import BrandIcon from '../BrandIcon.astro';
import AdminIcon from './AdminIcon.astro';
import { ADMIN_SOCIAL_ORDER_MAX } from '../../lib/admin-console/theme-shared';

interface Props {
  row: {
    id: 'github' | 'x' | 'email';
    label: string;
    orderInputId: string;
    inputId: string;
    inputType: 'url' | 'email';
    inputMode: 'url' | 'email';
    autoComplete: string;
    placeholder: string;
  };
}

const { row } = Astro.props;
const visibilityLabel = `隐藏 ${row.label}`;
const removeLabel = `${row.label} 为固定项，不可删除`;
const hrefLabel = row.id === 'email' ? '邮箱地址' : '链接地址';
---

<article class="admin-row admin-row--interactive admin-row--table admin-table__row admin-social-row admin-social-row--preset" data-social-preset-row data-social-preset-id={row.id}>
  <div class="admin-social-field admin-social-field--order admin-field--compact">
    <input
      class="admin-field__control admin-field__control--quiet admin-social-order"
      id={row.orderInputId}
      data-social-preset-field="order"
      type="number"
      min="1"
      max={String(ADMIN_SOCIAL_ORDER_MAX)}
      step="1"
      inputmode="numeric"
      aria-label={`${row.label} 位置排序`}
    />
  </div>

  <div class="admin-social-field admin-social-field--platform">
    <span class="admin-social-icon-preview">
      <span class="admin-social-icon-only">
        <BrandIcon name={row.id} class="admin-social-icon-only__icon" size={16} />
      </span>
    </span>
    <span class="admin-social-platform-name">{row.label}</span>
  </div>

  <div class="admin-social-field admin-social-field--href admin-field--compact">
    <input
      class="admin-field__control admin-field__control--quiet"
      id={row.inputId}
      data-social-preset-field="href"
      type={row.inputType}
      inputmode={row.inputMode}
      autocomplete={row.autoComplete}
      placeholder={row.placeholder}
      aria-label={`${row.label} ${hrefLabel}`}
    />
  </div>

  <div class="admin-social-field admin-social-field--actions">
    <div class="admin-social-row-actions">
      <button
        class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-social-action"
        type="button"
        data-social-preset-action="toggle-visible"
        aria-pressed="true"
        aria-label={visibilityLabel}
        title={visibilityLabel}
      >
        <AdminIcon name="eye" class="admin-social-action__icon" size={15} />
        <span class="sr-only">{visibilityLabel}</span>
      </button>
      <button
        class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-social-action"
        type="button"
        data-social-preset-action="remove"
        aria-label={removeLabel}
        title={removeLabel}
        disabled
        data-always-disabled
      >
        <AdminIcon name="trash" class="admin-social-action__icon" size={15} />
        <span class="sr-only">{removeLabel}</span>
      </button>
    </div>
  </div>
</article>
